managed implementation in class zbp_mmge_app1_re unique;
strict ( 2 );
with draft;

define behavior for ZMMGE_APP1_RE alias GateSecEntry
persistent table zmmge_hdr_t01
draft table zmmge_app1_re_dt
lock master total etag Lastchangedby
authorization master ( instance )
etag master Lastchangedby
{
  create ( authorization : global );
  update;
  delete;
  field ( readonly, numbering : managed ) Uuid;
  field ( mandatory : create )  Gateentryseries, Gateno;
  field ( readonly ) Gateentryid, Gateentryiddate, Securityremarks, Createdname;
  field ( mandatory ) Vehicleno, Vehicletype,Trasporterid,Licenseno,Engineno;
  field ( features : instance ) Minepassno, Forestpassno;

  draft action ( features : instance ) Edit;
  draft action Activate optimized;
  draft action Resume;
  draft action Discard;
  draft determine action Prepare;

  determination head_modify on save { create; }
  action ( features : instance ) PRINT result [1] $self;
  validation gatenocheck on save { create; update; }

  mapping for zmmge_hdr_t01 corresponding;
