projection;
strict ( 2 );
use draft;
use side effects;

define behavior for ZMMGE_APP2_PE alias GateHead
{
  use update;
  use delete;

  use action Purchase;
  use action GateCheckIn;
  use action WeightScrn;
  use action MigoPost;
  use action GateSlipForm;

  use action Edit;
  use action Activate;
  use action Resume;
  use action Discard;
  use action Prepare;

  use association _Item { create; with draft; }
}

define behavior for ZMMGE_APP2_PV1 alias GateItem
{
  use update;
  use delete;
  use action InbDelivery;
  use action ChallanInput;
  use association _Head { with draft; }
}