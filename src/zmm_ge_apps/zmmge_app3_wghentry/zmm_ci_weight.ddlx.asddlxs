  Purchaseorder;

  @UI: { lineItem:       [ { position: 35, label: 'Sub Gate no' } ],
         identification: [ { position: 35, label: 'Sub Gate no' } ] }
  @EndUserText.label: 'Sub Gate no'
  Subgateentryno;

  @UI: { lineItem:       [ { position: 40, label: 'Supplier' } ],
         identification: [ { position: 40, label: 'Supplier' } ] }
  @EndUserText.label: 'Supplier'
  Vendor;

  @UI: { lineItem:       [ { position: 50, label: 'Quantity' } ],
         identification: [ { position: 50, label: 'Quantity' } ] }
  @EndUserText.label: 'Quantity'
