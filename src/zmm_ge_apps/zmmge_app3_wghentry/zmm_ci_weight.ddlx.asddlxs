@Metadata.layer: #CUSTOMER
@UI: { headerInfo: { typeName: 'Inventory Gate Item',
                     typeNamePlural: 'Inventory Gate Item',
                     title: { type: #STANDARD, value: 'Material' } } }
@UI.deleteHidden: true
@UI.createHidden: true
annotate entity ZMM_CI_WEIGHT with
{
  @UI.facet: [ { id: 'Header',
                 purpose: #STANDARD,
                 type: #IDENTIFICATION_REFERENCE,
                 label: 'Inventory Item',
                 position: 10 } ]

  @UI.hidden: true
  Uuid;

  @UI: { lineItem:       [ { position: 10, label: 'Item' },
                           { type: #FOR_ACTION, dataAction: 'AutoFetchTWt', label: 'Auto Fetch Weight', position: 10 },
                           { type: #FOR_ACTION, dataAction: 'ManualFetchTWt', label: 'Manual Weight', position: 20, invocationGrouping: #CHANGE_SET }
  //                         { type: #FOR_ACTION, dataAction: 'GrossFetchTWt', label: 'Gross Weight', position: 30 }
                         ],
         identification: [ { position: 10, label: 'Item' }
  //                         { type: #FOR_ACTION, dataAction: 'ImgCapture', label: 'Image Capture', position: 10 },
  //                         { type: #FOR_ACTION, dataAction: 'AutoFetchTWt', label: 'Auto Fetch Weight', position: 20 },
  //                         { type: #FOR_ACTION, dataAction: 'ManualFetchTWt', label: 'Manual Weight', position: 30 }
                         ] }
  @EndUserText.label: 'Order No'
  Purchaseorderitem;

  @UI: { lineItem:       [ { position: 20, label: 'Item Code' } ],
         identification: [ { position: 20, label: 'Item Code' } ] }
  @EndUserText.label: 'Item Code'
  Material;

  @UI: { lineItem:       [ { position: 25, label: 'Unloading Status' } ],
         identification: [ { position: 25, label: 'Unloading Status' } ] }
