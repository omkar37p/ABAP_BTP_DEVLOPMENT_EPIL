  Gateentryseries;

  @EndUserText.label: 'Gate No'
  @UI.lineItem: [ { position: 30, label: 'Gate No' } ]
  @UI.identification: [ { position: 30, label: 'Gate No' } ]
  @UI.fieldGroup: [ { position: 30, qualifier: 'idSection1', importance: #HIGH } ]
  @Consumption.valueHelpDefinition: [ { entity: { name: 'ZGATE_NUM_VH', element: 'Gateno' },
                                        additionalBinding: [ { localElement: 'Gatenodes', element: 'Gatenodes' } ] } ]
  Gateno;

  @EndUserText.label: 'Plant'
  @UI.lineItem: [ { position: 40, label: 'Plant' } ]
