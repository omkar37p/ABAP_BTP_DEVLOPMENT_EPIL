  @UI.selectionField: [ { position: 10 } ]
  @UI.fieldGroup: [ { position: 40, qualifier: 'idSection1', importance: #HIGH } ]
  @Consumption.valueHelpDefinition: [ { entity: { name: 'ZMMGE_I_PLANTVH', element: 'Plant' },
