                 position: 15, label: 'Unloading Information', id: 'idSec2' },
               { id:            'POItems',
                 purpose:       #STANDARD,
                 type:          #LINEITEM_REFERENCE,
                 label:         'Order Item Details',
                 position:      25,
                 targetElement: '_Item' } ]
  @UI.hidden: true
  Uuid;

  @EndUserText.label: 'Gate Entry No'
  @EndUserText.quickInfo: 'Gate Entry No'
  @UI.lineItem: [ { position: 10, label: 'Gate Entry No' } ]
  @UI.identification: [ { position: 10, label: 'Gate Entry No' },
                        { type: #FOR_ACTION, dataAction: 'Unloadst',  label: 'Unloading Started',  position: 10 },
                        { type: #FOR_ACTION, dataAction: 'UnloadEnd', label: 'Unloading Finished', position: 20 } ]
  @UI.selectionField: [ { position: 20 } ]
