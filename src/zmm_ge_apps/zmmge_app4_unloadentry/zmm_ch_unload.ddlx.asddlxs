@Metadata.layer: #CUSTOMER
@UI: {
  headerInfo: {
    typeName: 'Loading & ZMM_CH_UNLOADs',
    typeNamePlural: 'Unloading Yard - Apps',
    title: { type: #STANDARD, value: 'Gateentryno' }
  }
}
@UI.deleteHidden: true
@UI.createHidden: true
annotate entity ZMM_CH_UNLOAD with
{
  @UI.facet: [ { id:        'GeneralInfo',
                 isSummary: true,
                 label:     'Inward Entry - Details',
                 type:      #COLLECTION,
                 purpose:   #STANDARD },
               { type: #FIELDGROUP_REFERENCE, targetQualifier: 'idSection1', parentId: 'GeneralInfo',
                 position: 10, label: 'Gate Entry - Details', id: 'idSection1' },
