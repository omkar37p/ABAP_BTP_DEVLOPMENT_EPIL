@Metadata.layer: #CUSTOMER
@UI: { headerInfo: {
         typeName: 'Inventory Gate Item',
         typeNamePlural: 'Inventory Gate Item',
         title: { type: #STANDARD, value: 'Material' } } }
@UI.deleteHidden: true
@UI.createHidden: true
@UI.updateHidden: true
annotate entity ZMM_CI_GEXIT with
{
  @UI.facet: [ { id:       'Header',
                 purpose:  #STANDARD,
                 type:     #IDENTIFICATION_REFERENCE,
                 label:    'Inventory Item',
                 position: 10 } ]
  @UI.hidden: true
  Uuid;

  @UI: { lineItem:       [ { position: 10, label: 'Item' } ],
         identification: [ { position: 10, label: 'Item' } ] }
  @EndUserText.label: 'Item'
  Purchaseorderitem;

  @UI: { lineItem:       [ { position: 20, label: 'Item Code' } ],
         identification: [ { position: 20, label: 'Item Code' } ] }
  @EndUserText.label: 'Item Code'
  Material;

  @UI: { lineItem:       [ { position: 30, label: 'Sub Gate no' } ],
         identification: [ { position: 30, label: 'Sub Gate no' } ] }
  @EndUserText.label: 'Sub Gate no'
  Subgateentryno;

  @UI.hidden: true
  Materialtext;

  @UI: { lineItem:       [ { position: 40, label: 'Order No' } ],
         identification: [ { position: 40, label: 'Order No' } ] }
  @EndUserText.label: 'Order No'
  Purchaseorder;

  @UI: { lineItem:       [ { position: 50, label: 'Supplier' } ],
         identification: [ { position: 50, label: 'Supplier' } ] }
  @EndUserText.label: 'Supplier'
  Vendor;

  @UI: { lineItem:       [ { position: 55, label: 'Plant' } ],
         identification: [ { position: 55, label: 'Plant' } ] }
  @EndUserText.label: 'Plant'
  Plant;

  @UI: { lineItem:       [ { position: 60, label: 'Tare Weight' } ],
         identification: [ { position: 60, label: 'Tare Weight' } ] }
  @EndUserText.label: 'Tare Weight'
  Tareweight;

  @UI: { lineItem:       [ { position: 70, label: 'Gross Weight' } ],
         identification: [ { position: 70, label: 'Gross Weight' } ] }
  @EndUserText.label: 'Gross Weight'
  Grossweight;

  @UI: { lineItem:       [ { position: 80, label: 'Net Weight' } ],
         identification: [ { position: 80, label: 'Net Weight' } ] }
  @EndUserText.label: 'Net Weight'
  Netweight;

  @UI: { lineItem:       [ { position: 90, label: 'Challan No' } ],
         identification: [ { position: 90, label: 'Challan No' } ] }
  @EndUserText.label: 'Challan No'
  Challanno;

  @UI: { lineItem:       [ { position: 95, label: 'Challan Date' } ],
         identification: [ { position: 95, label: 'Challan Date' } ] }
  @EndUserText.label: 'Challan Date'
  Challandate;

  @UI: { lineItem:       [ { position: 100, label: 'Challan Tare Wt' } ],
         identification: [ { position: 100, label: 'Challan Tare Wt' } ] }
  @EndUserText.label: 'Challan Tare Wt'
  Challantareweight;

  @UI: { lineItem:       [ { position: 110, label: 'Challan Gross Wt' } ],
         identification: [ { position: 110, label: 'Challan Gross Wt' } ] }
  @EndUserText.label: 'Challan Gross Wt'
  Challangrossweight;

  @UI: { lineItem:       [ { position: 115, label: 'Challan Net Wt' } ],
         identification: [ { position: 115, label: 'Challan Net Wt' } ] }
  @EndUserText.label: 'Challan Net Wt'
  Challannetweight;

  @UI: { lineItem:       [ { position: 120, label: 'Challan Qty' } ],
         identification: [ { position: 120, label: 'Challan Qty' } ] }
  @EndUserText.label: 'Challan Qty'
  Challanqty;

  @UI: { lineItem:       [ { position: 130, label: 'PO Order Type' } ],
         identification: [ { position: 130, label: 'PO Order Type' } ] }
  @EndUserText.label: 'PO Order Type'
  Poordertype;

  @UI: { lineItem:       [ { position: 140, label: 'Eway Billno' } ],
         identification: [ { position: 140, label: 'Eway Billno' } ] }
  @EndUserText.label: 'Eway Billno'
  Ewaybillno;

  @UI: { lineItem:       [ { position: 150, label: 'Eway BillDate' } ],
         identification: [ { position: 150, label: 'Eway BillDate' } ] }
  @EndUserText.label: 'Eway BillDate'
  Ewaybilldate;

  @UI: { lineItem:       [ { position: 160, label: 'Purchase Document' } ],
         identification: [ { position: 160, label: 'Purchase Document' } ] }
  @EndUserText.label: 'Purchase Document'
  Podocumt;

  @UI: { lineItem:       [ { position: 170, label: 'Challan Document' } ],
         identification: [ { position: 170, label: 'Challan Document' } ] }
  @EndUserText.label: 'Challan Document'
  Chdocumt;

  @UI: { lineItem:       [ { position: 180, label: 'Quality document' } ],
         identification: [ { position: 180, label: 'Quality document' } ] }
  @EndUserText.label: 'Quality document'
  Qadocumt;

  @UI.hidden: true
  Suppliername;
  @UI.hidden: true
  Gateentryno;
  @UI.hidden: true
  Plantname;
  @UI.hidden: true
  Baseunit;
  @UI.hidden: true
  Quantity;
  @UI.hidden: true
  Remark;
  @UI.hidden: true
  Weiuom;
  @UI.hidden: true
  Chbaseunit;
  @UI.hidden: true
  Chqtyunit;
  @UI.hidden: true
  Createdby;
  @UI.hidden: true
  Createdat;
  @UI.hidden: true
  Lastchangedby;
  @UI.hidden: true
  Lastchangedat;
  @UI.hidden: true
  /* Associations */
  _Head;
}