projection;
strict ( 2 );
use draft;
use side effects;

define behavior for ZSD_CH_DISPLAN alias DispHead
{
  use create;
  use update;
  use delete;

  use action ExcelUpload;

  use action Edit;
  use action Activate;
  use action Resume;
  use action Discard;
  use action Prepare;

  use association _SalesItem { create; with draft; }
}

define behavior for ZSD_CI_DISPLAN alias SalesOrder
{
  use update;
  use delete;

  use association _Head { with draft; }
}