      a.ewaybilldate         as Ewaybilldate,
      a.einvoiceno           as Einvoiceno,
      a.einvoicedate         as Einvoicedate,
      a.loadstdate           as Loadstdate,
      a.loadsttime           as Loadsttime,
      a.loadstindi           as Loadstindi,
