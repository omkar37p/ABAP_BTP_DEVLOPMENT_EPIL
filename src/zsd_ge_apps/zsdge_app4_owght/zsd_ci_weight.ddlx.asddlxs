@Metadata.layer: #CUSTOMER
@UI: { headerInfo: {
typeName: 'Dispatch Gate Item',
typeNamePlural: 'Dispatch Gate Item',
title: { type: #STANDARD, value: 'Material' }
}}
@UI.createHidden: true
@UI.updateHidden: true
@UI.deleteHidden: true
annotate entity ZSD_CI_WEIGHT with
{
  @UI.facet: [ { id: 'Header',
                 purpose: #STANDARD,
                 type: #IDENTIFICATION_REFERENCE,
                 label: 'Dispatch Gate Item',
                 position: 10 } ]
  @UI.hidden: true
  Uuid;

  @UI: { lineItem:       [ { position: 10, label: 'Order Item' } ],
         identification: [ { position: 10, label: 'Order Item' } ] }
  @EndUserText.label: 'Order Item'
  Salesitem;

  @UI: { lineItem:       [ { position: 20, label: 'Material' },
                           { type: #FOR_ACTION, dataAction: 'AutoFetchTWt', label: 'Auto Fetch Weight', position: 20, invocationGrouping: #CHANGE_SET },
                           { type: #FOR_ACTION, dataAction: 'ManualFetchTWt', label: 'Manual Weight', position: 30, invocationGrouping: #CHANGE_SET } ],
         identification: [ { position: 20, label: 'Material' } ] }
  @EndUserText.label: 'Material'
  Material;

  @UI: { lineItem:       [ { position: 30, label: 'Material Des' } ],
         identification: [ { position: 30, label: 'Material Des' } ] }
  @EndUserText.label: 'Material Des'
  Materialdesc;

  @UI: { lineItem:       [ { position: 40, label: 'Customer' } ],
         identification: [ { position: 40, label: 'Customer' } ] }
  @EndUserText.label: 'Customer'
  Customer;

  @UI: { lineItem:       [ { position: 50, label: 'Order No' } ],
         identification: [ { position: 50, label: 'Order No' } ] }
  @EndUserText.label: 'Order No'
  Salesdocument;

  @UI: { lineItem:       [ { position: 60, label: 'Plant' } ],
         identification: [ { position: 60, label: 'Plant' } ] }
  @EndUserText.label: 'Plant'
  Plant;

  @UI: { lineItem:       [ { position: 70, label: 'Storageloc' } ],
         identification: [ { position: 70, label: 'Storageloc' } ] }
  @EndUserText.label: 'Storageloc'
  @Consumption.valueHelpDefinition: [ { entity: { name: 'ZSD_SLOC_VH', element: 'Storagelocation' },
                                        additionalBinding: [ { localElement: 'Plant', element: 'Plant', usage: #FILTER } ] } ]
  Storagelocation;

  @UI.hidden: true
  Batch;

  @UI: { lineItem:       [ { position: 80, label: 'Order Quantity' } ],
         identification: [ { position: 80, label: 'Order Quantity' } ] }
  @EndUserText.label: 'Order Quantity'
  Quantity;

  @UI: { lineItem:       [ { position: 85, label: 'Open Order Qty' } ],
         identification: [ { position: 85, label: 'Open Order Qty' } ] }
  @EndUserText.label: 'Open Order Qty'
  OpenQtyLive;

  @UI.hidden: true
  OpenQty;

  @UI: { lineItem:       [ { position: 90, label: 'Tare Weight' } ],
         identification: [ { position: 90, label: 'Tare Weight' } ] }
  @EndUserText.label: 'Tare Weight'
  Tareweight;

  @UI: { lineItem:       [ { position: 100, label: 'Gross Weight' } ],
         identification: [ { position: 100, label: 'Gross Weight' } ] }
  @EndUserText.label: 'Gross Weight'
  Grossweight;

  @UI: { lineItem:       [ { position: 110, label: 'Net Weight' } ],
         identification: [ { position: 110, label: 'Net Weight' } ] }
  @EndUserText.label: 'Net Weight'
  Netweight;

  @UI: { lineItem:       [ { position: 120, label: 'Remark' } ],
         identification: [ { position: 120, label: 'Remark' } ] }
  @EndUserText.label: 'Remark'
  Remark;

  @UI: { lineItem:       [ { position: 130, label: 'Weighment Machine' } ],
         identification: [ { position: 130, label: 'Weighment Machine' } ] }
  @EndUserText.label: 'Weighment Machine'
  Weighmentmcno;

  @UI: { lineItem:       [ { position: 140, label: 'Image Count' } ],
         identification: [ { position: 140, label: 'Image Count' } ] }
  @EndUserText.label: 'Image Count'
  Itemimagecount;

  @UI.hidden: true
  Weighmentmcndes;
  @UI.hidden: true
  Ordertype;
  @UI.hidden: true
  Distributionchannel;
  @UI.hidden: true
  Deliveryno;
  @UI.hidden: true
  Deliveritem;
  @UI.hidden: true
  Customername;
  @UI.hidden: true
  Gateentryno;
  @UI.hidden: true
  Plantname;
  @UI.hidden: true
  Baseunit;
  @UI.hidden: true
  Independentrequirementtype;
  @UI.hidden: true
  Createdby;
  @UI.hidden: true
  Createdat;
  @UI.hidden: true
  Lastchangedby;
  @UI.hidden: true
  Lastchangedat;
  @UI.hidden: true
  _Head;
}