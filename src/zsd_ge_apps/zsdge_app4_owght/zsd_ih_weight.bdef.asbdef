  Drivermobile, Remarks, Customer, Customername, Fromplace, Billingfrom, Consignee,
  Billto, Broker, Doremark, Division, Attachment, Mimetype, Filename, Attachmentwt,
  Mimetypewt, Filenamewt, Weigmentindicator, Weighmentindicator, Weighmentmcno,
  Weighmentmcndes, Weighmentdate, Weighmenttime, Weighuom, Tarewt, Deliveryno,
  Materialdocument, Materialdocumentyear, Picqtindicator, Gateentrystatus, Criticality,
  Createdby, Createdat, Lastchangedby, Lastchangedat;
  field ( readonly ) Imgseqnotare, Imgseqnogross, Imgvrstatustare, Imgvrstatusgross, Imgrejreason,
  Imgstatustaretext, Imgcrittare, Imgstatusgrosstext, Imgcritgross;

  association _Item { with draft; }

  draft action ( features : instance ) Edit;
  draft action Activate optimized;
  draft action Resume;
  draft action Discard;
  draft determine action Prepare;

  action ( features : instance ) Weighmentslip result [1] $self;
  action ( features : instance ) CancelGateEntry result [1] $self;
  action ( features : instance ) AutoFetchWt parameter ZSD_AUTOWT_INP result [1] $self;
  action ( features : instance ) ManualFetchWt parameter ZSD_WEIGHT_INP result [1] $self;

  action ( features : instance ) CrtDelivery result [1] $self;
  action ( features : instance ) UpDlyheadertext result [1] $self;
  action ( features : instance ) PickingQty result [1] $self;
  action ( features : instance ) DeliveryPG result [1] $self;
  action ( features : instance ) TransExit result [1] $self;
  action ( features : instance ) RecaptureTare parameter ZSD_AUTOWT_INP result [1] $self;
  action ( features : instance ) RecaptureGross parameter ZSD_AUTOWT_INP result [1] $self;

  side effects
  {
    action ManualFetchWt affects $self, entity _Item;
    action AutoFetchWt affects $self, entity _Item;
    action RecaptureTare affects $self;
    action RecaptureGross affects $self;
  }

  mapping for zsdge_sentry_ht1 corresponding;
}

define behavior for ZSD_II_WEIGHT alias WeightItem
persistent table zsdge_sentry_it1
