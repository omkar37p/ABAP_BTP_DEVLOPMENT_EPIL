managed implementation in class zbp_sd_ih_weight unique;
strict ( 2 );
with draft;

define behavior for ZSD_IH_WEIGHT alias WeightHead
persistent table zsdge_sentry_ht1
draft table zsdge_owght_dht
lock master
total etag Lastchangedat
authorization master ( instance )
etag master Lastchangedat
{
  update ( features : instance );
  // create / delete: owned by Security Entry (zsdge_sentry_ht1 is shared)

  field ( readonly ) Uuid;
  field ( readonly ) Gateno, Gatenodes, Plant, Plantname, Gateentryid, Gateentryiddate, Cancelgateentry,
  Gateentryidtime, Gateentrytype, Gateentrytypetext, Gateentryno, Gateentrysequence,
